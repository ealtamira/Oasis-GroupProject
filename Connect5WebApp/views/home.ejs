<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/site.css" />

    <script
      src="https://cdn.jsdelivr.net/npm/onnxruntime-web/dist/ort.min.js"
      defer
    ></script>

    <script src="/js/site2.js" defer></script>

    <title>Oasis | Connect 5 AI</title>
  </head>

  <body>
    <header>
      <h1>Connect 5 With Power-Ups</h1>
      <h2 id="eventText">Ready Player One</h2>
    </header>

    <main class="game-container">
      <div class="gameBoard" id="board"></div>

      <div class="powerups">
        <div id="p1powerup" title="Player 1 Power-up"></div>
        <div id="resetbutton"></div>
        <div id="p2powerup" title="Player 2 Power-up"></div>
      </div>

      <div id="predict-container">
        <p id="predict">🧠 AI Analyzing Board...</p>
      </div>
    </main>

    <footer>
      <p>Copyright © OASIS 2026</p>
    </footer>
  </body>
</html>
